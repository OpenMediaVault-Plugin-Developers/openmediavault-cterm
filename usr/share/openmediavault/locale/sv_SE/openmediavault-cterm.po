msgid "Auto-login secret"
msgstr "Hemlighet för automatisk inloggning"

msgid ""
"Auto-login secret is too short.  Must be at least 32 characters or disabled "
"with 0 characters."
msgstr ""
"Hemligheten för automatisk inloggning är för kort. Den måste innehålla minst"
" 32 tecken eller inaktiveras genom att lämnas tom."

msgid "Auto-login user"
msgstr "Användare för automatisk inloggning"

msgid "Base path"
msgstr "Grundsökväg"

msgid "Base path to use. Leave blank to disable."
msgstr "Bassökväg som ska användas. Lämna tomt för att inaktivera."

msgid "CTerm"
msgstr "CTerm"

msgid "Date & Time"
msgstr "Datum och tid"

msgid "Enable"
msgstr "Aktivera"

msgid "Enable host shell option in container list."
msgstr "Aktivera alternativet för värdskal i containerlistan."

msgid "Host"
msgstr "Värd"

msgid "Host shell"
msgstr "Värdskal"

msgid "IP to listen on. Use 0.0.0.0 for all IPs."
msgstr ""
"IP-adress som tjänsten ska lyssna på. Använd 0.0.0.0 för alla IP-adresser."

msgid ""
"Leave blank to disable auto-login.<br/>Should be between 32 and 64 "
"characters.<br/>Enter 'random' to generate a random string between 32 and 64"
" chars.<br/>Enter 'random64' where the number 64 can be the length between "
"32 and 64."
msgstr ""
"Lämna tomt för att inaktivera automatisk inloggning.<br/>Värdet bör "
"innehålla mellan 32 och 64 tecken.<br/>Ange ”random” för att skapa en "
"slumpmässig sträng på mellan 32 och 64 tecken.<br/>Ange ”random64”, där "
"talet 64 kan ersättas med en längd mellan 32 och 64."

msgid "Level"
msgstr "Nivå"

msgid "Message"
msgstr "Meddelande"

msgid "Module"
msgstr "Modul"

msgid "Open UI"
msgstr "Öppna användargränssnittet"

msgid ""
"Override auto-login user for admins.<br/>Leave blank to use web interface "
"user.<br/>Non-admins will always use web interface user."
msgstr ""
"Åsidosätt användaren för automatisk inloggning för "
"administratörer.<br/>Lämna tomt för att använda webbgränssnittets "
"användare.<br/>Icke-administratörer använder alltid webbgränssnittets "
"användare."

msgid "Port"
msgstr "Port"

msgid "Port to listen on."
msgstr "Lyssningsport."

msgid "Reverse proxy"
msgstr "Omvänd proxy"

msgid "Select a user ..."
msgstr "Välj en användare…"

msgid ""
"Serve the terminal through the openmediavault web server, e.g. https://omv-"
"host/cterm.<br/>Requires a base path to be set. The web server terminates "
"TLS, so the backend listens on plain HTTP locally."
msgstr ""
"Tillhandahåll terminalen via OpenMediaVaults webbserver, t.ex. https://omv-"
"host/cterm.<br/>En bassökväg måste anges. Webbservern avslutar TLS, så "
"bakänden lyssnar lokalt via okrypterad HTTP."

msgid "Update components"
msgstr "Uppdatera komponenter"

msgid "Update terminal components"
msgstr "Uppdatera terminalkomponenter"

msgid "Updated cterm settings."
msgstr "CTerm-inställningarna har uppdaterats."

msgid "User must be in cterm group to login."
msgstr "Användaren måste tillhöra gruppen cterm för att kunna logga in."
